# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git, so the real keys never reach GitHub.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET - server only (checkout route + seed script). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET - server only (AI "describe my photo" feature, free key from aistudio.google.com)
GEMINI_API_KEY=your-gemini-key
